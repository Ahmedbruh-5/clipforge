# ClipForge backend configuration
APP_NAME=ClipForge
DEBUG=true
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://127.0.0.1:5173

# Database — SQLite by default (local-first). For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://clipforge:clipforge@localhost:5432/clipforge
# DATABASE_URL=sqlite:///./database/clipforge.db

MAX_UPLOAD_BYTES=2147483648
ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.webm
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YouTube OAuth (optional — connect later)
# 1. Create an OAuth client in Google Cloud Console (Desktop or Web)
# 2. Enable YouTube Data API v3
# 3. Add authorized redirect URI exactly:
#    http://127.0.0.1:8000/api/youtube/callback
# 4. Paste credentials below, restart backend, open Settings → Connect YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback
# YOUTUBE_TOKEN_PATH=./storage/secrets/youtube_token.json
